# Environment variables used only for End-to-End (E2E) test runs.
# This file is loaded by Docker Compose during E2E executions to override
# default settings without modifying the base docker-compose files.
ONLINE_THEMES_INSTALL=1
APP_PORT=8080
ADMIN_EMAIL=admin@exelearning.test
ADMIN_PASSWORD=AdminPass123!
# Shared with Playwright when E2E_BASE_URL points at this stack. The in-process
# server generates its own secret; this one is fixed because Docker is already
# running when the Synology login spec signs its assertion.
E2E_SYNOLOGY_SECRET=e2e-synology-sso-secret-not-for-production
