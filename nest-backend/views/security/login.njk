{% extends "base.njk" %}

{% block stylesheets %}
    <link class="exe" rel="stylesheet" href="/libs/bootstrap/bootstrap.min.css">
    <link class="exe" rel="stylesheet" href="/style/workarea/main.css">
{% endblock %}

{% block class %}login-page{% endblock %}
{% block title %}eXeLearning{% endblock %}

{% block body %}
<section id="login-tpl" role="main">
    <div class="login-left">
        <div class="card-body text-black">
            <img src="/images/logo.svg" alt="" class="logo mb-3">
                <div id="exe-version" class="small">
                    <span class="visually-hidden">Version:</span>
                    {{ app_version or '3.0.0' }}
                </div>
                {% if not user %}
                <h1 class="sign-in">Sign in</h1>
                <p class="hello-again">Hello again! Please enter your credentials.</p>
                {% endif %}
                {% if error %}
                    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    {{ error }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endif %}
                {% if user %}
                    <h1 class="sign-in visually-hidden">Sign in</h1>
                    <div class="text-center text-md-start">
                    <p class="mb-4">Logged in as <strong>{{ user.username }}</strong></p>
                    <a href="/workarea" class="btn button-secondary logout-button">Work area</a>
                    <a href="/logout" class="btn button-primary logout-button mx-1">Logout</a>
                    </div>
                {% else %}
                    {% if auth_methods and 'password' in auth_methods %}
                    <form id="login-form" name="login" action="/login_check" method="post" data-turbo="false">
                        <h2 class="visually-hidden">Sign in</h2>
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token }}">
                        <div class="login-user">
                            <label for="inputEmail">Email</label>
                            <input type="email" id="inputEmail" class="form-control mb-2" name="email" value="{{ last_username or '' }}" placeholder="Email" required>
                        </div>
                        <div class="login-password">
                            <label for="inputPassword">Password</label>
                            <input type="password" class="form-control" id="inputPassword" name="password" placeholder="Password" required>
                        </div>
                        <button class="login-submit btn button-primary btn-lg btn-block w-100" id="login-form-btn-submit" name="btn-submit" type="submit">Sign in</button>
                    </form>
                    {% endif %}

                    {% if auth_methods and ('cas' in auth_methods or 'openid' in auth_methods or 'guest' in auth_methods) %}
                    {# Additional login method buttons #}
                    <div class="other-methods">
                        {% if 'password' in auth_methods %}
                        <p class="small">Other authentication methods:</p>
                        {% else %}
                        <p class="small">Authentication methods:</p>
                        {% endif %}
                        <div class="other-methods-buttons d-flex g-5">
                        {% if 'cas' in auth_methods %}
                            <a href="/login/cas" id="login-link-cas" rel="nofollow noreferrer" class="btn btn-secondary d-flex justify-content-center align-items-center me-2" data-turbo="false" data-no-prefetch>CAS</a>
                        {% endif %}
                        {% if 'openid' in auth_methods %}
                            <a href="/login/openid" id="login-link-openid" rel="nofollow noreferrer" class="btn btn-secondary d-flex justify-content-center align-items-center me-2" data-turbo="false" data-no-prefetch>OpenID</a>
                        {% endif %}
                        {% if 'guest' in auth_methods %}
                            <form method="post" action="/login/guest" id="login-form-guest" class="d-inline" data-turbo="false" data-no-prefetch>
                                <input type="hidden" name="guest_login_nonce" value="{{ guest_login_nonce or '' }}">
                                <button type="submit" id="login-link-guest" class="btn btn-secondary d-flex justify-content-center align-items-center me-2">Guest</button>
                            </form>
                        {% endif %}
                        </div>
                    </div>
                    {% endif %}
            {% endif %}
        </div>
    </div>
    <div class="login-right"></div>
</section>
<script class="exe" src="/libs/bootstrap/bootstrap.bundle.min.js" defer></script>
{% endblock %}
