#!/bin/sh
set -eu
: "${SYNOPKG_PKGDEST:?DSM did not provide SYNOPKG_PKGDEST}"
: "${SYNOPKG_PKGVAR:?DSM did not provide SYNOPKG_PKGVAR}"
PID_FILE="$SYNOPKG_PKGVAR/run/exelearning.pid"
ENV_FILE="$SYNOPKG_PKGVAR/config/runtime.env"
LOG_FILE="$SYNOPKG_PKGVAR/logs/exelearning.log"
SERVER="$SYNOPKG_PKGDEST/app/exelearning-server"
is_running() {
    [ -f "$PID_FILE" ] || return 1
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$pid" -gt 1 ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    executable="$(readlink "/proc/$pid/exe" 2>/dev/null)" || return 1
    expected="$(readlink -f "$SERVER" 2>/dev/null)" || return 1
    [ -n "$executable" ] && [ "$executable" = "$expected" ]
}
case "${1:-}" in
    start)
        [ "$(id -u)" -ne 0 ] || { echo 'Refusing to run eXeLearning as root' >&2; exit 1; }
        is_running && exit 0
        rm -f "$PID_FILE"
        set -a
        # shellcheck disable=SC1090
        . "$ENV_FILE"
        set +a
        APP_VERSION="v$(cat "$SYNOPKG_PKGDEST/app/VERSION")"
        export APP_VERSION
        cd "$SYNOPKG_PKGDEST/app"
        nohup "$SERVER" >> "$LOG_FILE" 2>&1 &
        pid=$!
        echo "$pid" > "$PID_FILE"
        sleep 1
        kill -0 "$pid" 2>/dev/null || { rm -f "$PID_FILE"; exit 1; }
        ;;
    stop)
        if is_running; then
            pid="$(cat "$PID_FILE")"
            kill -TERM "$pid"
            count=0
            while is_running && [ "$count" -lt 30 ]; do sleep 1; count=$((count + 1)); done
            if is_running; then kill -KILL "$pid"; fi
        fi
        rm -f "$PID_FILE"
        ;;
    status)
        is_running && exit 0
        rm -f "$PID_FILE"
        exit 3
        ;;
    *) echo "Usage: $0 {start|stop|status}" >&2; exit 2 ;;
esac
