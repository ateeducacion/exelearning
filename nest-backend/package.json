{
  "name": "nest-backend",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:debug": "ts-node-dev --inspect --respawn --transpile-only src/main.ts",
    "start:prod": "node dist/src/main.js",
    "seed": "ts-node src/database/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "electron:dev": "USE_NEST_BACKEND=1 EXELEARNING_DEBUG_MODE=1 electron .",
    "electron:pack": "USE_NEST_BACKEND=1 electron-builder",
    "electron:bench": "echo \"Use electron:dev or electron:pack\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.9",
    "@types/express-session": "^1.18.2",
    "@types/nunjucks": "^3.2.6",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "electron-log": "^5.4.0",
    "electron-updater": "^6.6.2",
    "express-session": "^1.18.2",
    "fast-xml-parser": "^5.3.2",
    "fs-extra": "^11.3.2",
    "jszip": "^3.10.1",
    "mysql2": "^3.15.3",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "sql.js": "^1.13.0",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.9",
    "@playwright/test": "^1.55.0",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/jszip": "^3.4.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.10.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "es.intef.exelearning",
    "productName": "eXeLearning",
    "directories": {
      "output": "dist/electron"
    },
    "compression": "normal",
    "publish": [
      {
        "provider": "github",
        "owner": "exelearning",
        "repo": "exelearning",
        "releaseType": "prerelease",
        "channel": "latest"
      }
    ],
    "afterPack": "../packaging/afterPack.js",
    "afterSign": "../packaging/notarize.js",
    "asar": true,
    "disableDefaultIgnoredFiles": true,
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/update-manager.js",
      "../.env.dist",
      "../translations/en.json",
      "../translations/es.json",
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "USE_NEST_BACKEND": "1"
    },
    "fileAssociations": [
      {
        "ext": "elpx",
        "name": "eXeLearning Project",
        "description": "eXeLearning project file",
        "role": "Editor",
        "mimeType": "application/x-exelearning-elpx"
      }
    ],
    "extraResources": [
      {
        "from": "../public/",
        "to": "public/"
      },
      {
        "from": "../templates/",
        "to": "templates/"
      },
      {
        "from": "../translations/",
        "to": "translations/"
      },
      {
        "from": "../.env.dist",
        "to": ".env.dist"
      },
      {
        "from": "../packaging/keys/",
        "to": "keys/"
      },
      {
        "from": "dist/",
        "to": "nest-backend/dist/"
      },
      {
        "from": "node_modules/",
        "to": "nest-backend/node_modules/"
      },
      {
        "from": "views/",
        "to": "nest-backend/views/"
      },
      {
        "from": "public/",
        "to": "nest-backend/public/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../public/exelearning.ico",
      "legalTrademarks": "INTEF",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "eXeLearning"
    },
    "linux": {
      "executableName": "exelearning",
      "executableArgs": [
        "--no-sandbox"
      ],
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "icon": "../public/icons"
    },
    "mac": {
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "../public/exe_elp.icns",
      "entitlements": "../packaging/entitlements.mac.plist",
      "entitlementsInherit": "../packaging/entitlements.mac.inherit.plist"
    },
    "dmg": {
      "format": "ULFO"
    }
  }
}
