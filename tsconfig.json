{
    "compilerOptions": {
        "module": "Preserve",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "target": "ES2022",
        "types": ["bun"],
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "resolveJsonModule": true
    },
    "exclude": [
        "node_modules",
        "test",
        "dist",
        "app/dist",
        "**/*.spec.ts",
        "**/*.e2e-spec.ts",
        "**/*.integration.spec.ts"
    ]
}
